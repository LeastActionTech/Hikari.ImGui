<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- NuGet Packaging Properties -->
    <PackageId>Hikari.ImGui</PackageId>
    <Authors>Akshay Mishra, Omar Cornut</Authors>
    <Company>Least Action Technologies Inc.</Company>
    <Copyright>Copyright (c) 2026 Least Action Technologies Inc., Copyright (c) 2014-2026 Omar Cornut and Dear ImGui contributors</Copyright>
    <Description>Pure C# re-implementation of Dear ImGui v1.93.0-docking with zero native dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/LeastActionTech/Hikari.ImGui</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/LeastActionTech/Hikari.ImGui</RepositoryUrl>
    <PackageTags>imgui;dear-imgui;gui;gamedev;csharp;pure;docking</PackageTags>
    <PackageOutputPath>../artifacts/packages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hikari.ImGui.Test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildTransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
