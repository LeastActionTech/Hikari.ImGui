<Project>
  <!--
    Resolves the short Git commit hash and supplies it to MinVer as build metadata.
    This populates InformationalVersion (<version>+<short_hash>) for runtime diagnostics and traceability,
    while leaving PackageVersion clean (<version>) for NuGet / SemVer conventions.
  -->
  <Target Name="SetMinVerGitCommitHash" BeforeTargets="MinVer" Condition="'$(MinVerBuildMetadata)' == ''">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortCommitHash" />
    </Exec>
    <PropertyGroup Condition="'$(_GitShortCommitHash)' != ''">
      <MinVerBuildMetadata>$([System.String]::Copy('$(_GitShortCommitHash)').Trim())</MinVerBuildMetadata>
    </PropertyGroup>
  </Target>

  <!--
    Synchronizes AssemblyVersion with FileVersion so both reflect the full version (e.g. 1.93.1.0)
    rather than defaulting AssemblyVersion to 1.0.0.0.
  -->
  <Target Name="SyncAssemblyVersionToFileVersion" AfterTargets="MinVer">
    <PropertyGroup>
      <AssemblyVersion>$(FileVersion)</AssemblyVersion>
    </PropertyGroup>
  </Target>
</Project>
